# 실제 비밀값은 .env에 작성하고 커밋하지 않습니다.
MODEL_PROVIDER=upstage
MODEL_NAME=solar-pro2
UPSTAGE_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
AGENT_SYSTEM_DB_PATH=.data/agent-system.sqlite3
AGENT_MAX_RUNS=3
AGENT_QUEUE_CAPACITY=100
AGENT_WORKER_COUNT=1
AGENT_NOTIFICATION_LEASE_SECONDS=30
AGENT_NOTIFICATION_SEND_TIMEOUT_SECONDS=20
AGENT_NOTIFICATION_HEARTBEAT_SECONDS=5
