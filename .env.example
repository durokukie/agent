# Kukie 설정 예시 — 이 파일을 .env 로 복사해서 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있다. 실제 키를 커밋하지 않는다.
# 셸에서 export 한 값이 .env 보다 우선한다 (load_dotenv 는 기존 환경변수를 덮어쓰지 않음).

# ── 모델 ────────────────────────────────────────────────────
# 미지정 시 'test'(TestModel) — 키 없이 import·테스트가 가능하다.
# 제공사 접두사는 pydantic-ai 가 지원하는 것을 그대로 쓴다.
#   anthropic:claude-sonnet-4-6        (ANTHROPIC_API_KEY 필요)
#   openrouter:anthropic/claude-sonnet-4.5  (OPENROUTER_API_KEY 필요)
KUKIE_MODEL=test

# 승인 카드의 판단 가이드를 만드는 별도 에이전트. 미지정(주석) 시 openai:gpt-5.6-luna.
# 메인 모델과 같은 제공사로 맞추면 키를 한 벌만 준비하면 된다.
# 이 호출이 실패하면 훅이 "guidance unavailable" 로 기록하고 승인은 계속 진행한다 —
# 터지지 않고 조용히 빈칸이 되므로, 값이 맞는지 확인이 필요하다.
# KUKIE_GUIDANCE_MODEL=openrouter:openai/gpt-5-mini

# ── API 키 ──────────────────────────────────────────────────
# 위에서 고른 제공사에 해당하는 것만 채우면 된다.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 관측 (선택) ─────────────────────────────────────────────
# 둘 중 하나라도 있으면 계측이 켜진다. 없으면 아무 일도 하지 않는다.
# Logfire 클라우드:
LOGFIRE_TOKEN=
# 자가 호스팅 OTLP 수집기 (예: http://localhost:4318):
OTEL_EXPORTER_OTLP_ENDPOINT=

# 1 이면 프롬프트·응답 본문까지 기록한다. 스모크에서는 켜야 판단 품질을 볼 수 있고,
# 대화에는 클러스터 정보가 들어가므로 배포 시점 정책은 별도 결정 사항이다.
KUKIE_TRACE_CONTENT=

# ── E2E (선택) ──────────────────────────────────────────────
# kind 클러스터 E2E 를 돌릴 때만. 실제 kind 관리 클러스터가 아니면 테스트가 거부한다.
KUKIE_E2E_CONTEXT=

# ── 채팅방 저장소 (kukie/store) ──────────────────────────────
# 미지정 시 SQLite ~/.kukie/kukie.db. Postgres 는 postgresql+psycopg://user:pw@host/db (psycopg 설치 필요).
KUKIE_DATABASE_URL=

# ── 회원 서버 (kukie/auth) ──────────────────────────────────
# Spring kukie-server 주소. 있으면 토큰을 GET /users/me 로 확인한다 (개발용 헤더는 무시).
#   토큰은 Authorization: Bearer 헤더(앱)로 오거나, 없으면 Spring 이 구운 httpOnly 쿠키(웹)에서 읽는다.
# 없으면 KUKIE_DEV_AUTH=1 일 때만 개발 모드: X-User 헤더나 KUKIE_DEV_USER 를 회원 id 로 쓴다.
# 둘 다 없으면 503 AUTH_NOT_CONFIGURED — 변수 하나 빠뜨렸다고 무인증 서버가 되지 않게 (fail-closed).
# 로컬에서 Spring 없이 돌리려면 .env 에 KUKIE_DEV_AUTH=1 을 직접 넣는다 (예시 파일 기본값은 비워 둔다).
KUKIE_MEMBER_URL=
KUKIE_DEV_AUTH=
KUKIE_DEV_USER=
# 웹이 보내는 access 쿠키 이름. 기본 kukie_access — kukie-server 의 auth.cookie.access-name 과 같아야 한다.
# 쿠키 인증 규칙 (kukie/auth.py): Authorization 헤더가 있으면 헤더만(틀리면 401), 없을 때만 쿠키.
# 쿠키로만 인증된 요청은 브라우저의 Sec-Fetch-Site 가 same-origin/none 일 때만 받는다 — 없거나 cross-site/same-site 면
# 403 CROSS_SITE_COOKIE. 브라우저는 이 헤더를 HTTPS(또는 localhost)에서만 붙인다. 웹은 HTTPS 리버스 프록시 뒤에서
# agent 와 같은 오리진(/api)으로 부른다는 전제다. localhost 가 아닌 평문 HTTP 로 띄우면 — Spring 쿠키가 Secure
# (kukie-server auth.cookie.secure, 기본 true)면 쿠키가 안 실려 401, 끈 채면 헤더가 없어 403 — 어느 쪽이든 HTTPS 로
# 올리라는 신호다. http://localhost 는 브라우저가 Secure 쿠키도 헤더도 붙여 주므로 로컬 개발은 평문이어도 그대로 돈다.
# KUKIE_ACCESS_COOKIE=kukie_access

# ── 클러스터 등록 (기획 04 §8, issue #61) ────────────────────
# 등록한 클러스터의 자격증명(토큰·개인키)을 DB 에 넣기 전에 암호화하는 키.
# 없으면 클러스터 등록·사용이 거부된다 (fail-closed) — 평문으로 조용히 넘어가지 않게.
# 만드는 법:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KUKIE_SECRET_KEY=

# 1 이면 사설·로컬 주소(kind 의 https://127.0.0.1:6443 등)도 등록할 수 있다.
# 기본은 막는다 — 서버가 노트북 밖으로 나가면 그런 주소에는 닿지 않는다. 로컬 개발에서만 켠다.
# KUKIE_ALLOW_LOCAL_CLUSTER=1
